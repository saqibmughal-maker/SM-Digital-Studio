doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='SM Digital Studio provides professional AI Image Editing, Video Editing, Graphic Design, Responsive Website Development, and Social Media Marketing services.')
        meta(name='author', content='SM Digital Studio')
        meta(property='og:title', content='SM Digital Studio')
        meta(property='og:description', content='Professional AI Image Editing, Video Editing, Graphic Design, Responsive Website Development & Social Media Marketing.')
        meta(property='og:type', content='website')

        title SM Digital Studio | AI Image Editing, Video Editing & Graphic Design

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Montserrat:400,700', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700', rel='stylesheet', type='text/css')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-dark.fixed-top
            .container
                a.navbar-brand(href='#page-top')
                    span.logo-sm SM
                    span.logo-text Digital Studio
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    | Menu
                    i.fas.fa-bars.ms-1
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.text-uppercase.ms-auto.py-4.py-lg-0
                        li.nav-item
                            a.nav-link(href='#services') Services
                        li.nav-item
                            a.nav-link(href='#portfolio') Portfolio
                        li.nav-item
                            a.nav-link(href='#about') About
                        li.nav-item
                            a.nav-link(href='#team') Team
                        li.nav-item
                            a.nav-link(href='#contact') Contact
        // Masthead
        header.masthead
            .container
                .masthead-subheading Welcome to SM Digital Studio
                .masthead-heading.text-uppercase AI DIGITAL SERVICES FOR MODERN BRANDS
                a.btn.btn-primary.btn-xl.text-uppercase(href='#services') View Our Services

        // Services
        section#services.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Services
                    h3.section-subheading.text-muted Have a project in mind? We'd love to hear from you. Contact SM Digital Studio today. — helping businesses, brands, and creators grow through creative design, AI solutions, and digital innovation.
                .row.text-center
                    .col-md-4
                        span.fa-stack.fa-4x
                            i.fas.fa-circle.fa-stack-2x.text-primary
                            i.fas.fa-shopping-cart.fa-stack-1x.fa-inverse
                        h4.my-3 AI Image Editing
                        p.text-muted
                            | Professional AI-powered photo editing, background replacement, retouching, object removal, color correction, and premium image enhancement.
                    .col-md-4
                        span.fa-stack.fa-4x
                            i.fas.fa-circle.fa-stack-2x.text-primary
                            i.fas.fa-laptop.fa-stack-1x.fa-inverse
                        h4.my-3 Video Editing
                        p.text-muted
                           | Professional video editing for YouTube, TikTok, Instagram Reels, business ads, promotional videos, and social media content.
                    .col-md-4
                        span.fa-stack.fa-4x
                            i.fas.fa-circle.fa-stack-2x.text-primary
                            i.fas.fa-lock.fa-stack-1x.fa-inverse
                        h4.my-3 Instagram & Facebook
                        p.text-muted
                            | Creative logo design, social media posts, banners, flyers, business cards, thumbnails, and professional Marketing Design materials.

        // Portfolio Grid
        section#portfolio.page-section.bg-light
            .container
                .text-center
                    h2.section-heading.text-uppercase Our Portfolio
                    h3.section-subheading.text-muted Have a project in mind? We'd love to hear from you. Contact SM Digital Studio today. — helping businesses, brands, and creators grow through creative design, AI solutions, and digital innovation.
                .row
                    .col-lg-4.col-sm-6.mb-4
                        // Portfolio item 1
                        .portfolio-item
                            a.portfolio-link(data-bs-toggle='modal', href='#portfolioModal1')
                                .portfolio-hover
                                    .portfolio-hover-content
                                        i.fas.fa-plus.fa-3x
                                img.img-fluid(src='assets/img/portfolio/1.jpg', alt='...')
                            .portfolio-caption
                                .portfolio-caption-heading AI Image Editing
                                .portfolio-caption-subheading.text-muted Professional Retouching
                    .col-lg-4.col-sm-6.mb-4
                        // Portfolio item 2
                        .portfolio-item
                            a.portfolio-link(data-bs-toggle='modal', href='#portfolioModal2')
                                .portfolio-hover
                                    .portfolio-hover-content
                                        i.fas.fa-plus.fa-3x
                                img.img-fluid(src='assets/img/portfolio/2.jpg', alt='...')
                            .portfolio-caption
                                .portfolio-caption-heading Video Editing
                                .portfolio-caption-subheading.text-muted Instagram & Facebook
                    .col-lg-4.col-sm-6.mb-4
                        // Portfolio item 3
                        .portfolio-item
                            a.portfolio-link(data-bs-toggle='modal', href='#portfolioModal3')
                                .portfolio-hover
                                    .portfolio-hover-content
                                        i.fas.fa-plus.fa-3x
                                img.img-fluid(src='assets/img/portfolio/3.jpg', alt='...')
                            .portfolio-caption
                                .portfolio-caption-heading Graphic Design
                                .portfolio-caption-subheading.text-muted Brand Identity
                    .col-lg-4.col-sm-6.mb-4.mb-lg-0
                        // Portfolio item 4
                        .portfolio-item
                            a.portfolio-link(data-bs-toggle='modal', href='#portfolioModal4')
                                .portfolio-hover
                                    .portfolio-hover-content
                                        i.fas.fa-plus.fa-3x
                                img.img-fluid(src='assets/img/portfolio/4.jpg', alt='...')
                            .portfolio-caption
                                .portfolio-caption-heading AI Poster Design
                                .portfolio-caption-subheading.text-muted Marketing Design
                    .col-lg-4.col-sm-6.mb-4.mb-sm-0
                        // Portfolio item 5
                        .portfolio-item
                            a.portfolio-link(data-bs-toggle='modal', href='#portfolioModal5')
                                .portfolio-hover
                                    .portfolio-hover-content
                                        i.fas.fa-plus.fa-3x
                                img.img-fluid(src='assets/img/portfolio/5.jpg', alt='...')
                            .portfolio-caption
                                .portfolio-caption-heading Responsive Website
                                .portfolio-caption-subheading.text-muted Responsive Website
                    .col-lg-4.col-sm-6
                        // Portfolio item 6
                        .portfolio-item
                            a.portfolio-link(data-bs-toggle='modal', href='#portfolioModal6')
                                .portfolio-hover
                                    .portfolio-hover-content
                                        i.fas.fa-plus.fa-3x
                                img.img-fluid(src='assets/img/portfolio/6.jpg', alt='...')
                            .portfolio-caption
                                .portfolio-caption-heading Social Media Marketing
                                .portfolio-caption-subheading.text-muted Content Creation

        // About
        section#about.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Our Journey
                    h3.section-subheading.text-muted Have a project in mind? We'd love to hear from you. Contact SM Digital Studio today. — helping businesses, brands, and creators grow through creative design, AI solutions, and digital innovation.
                ul.timeline
                    li
                        .timeline-image
                            img.rounded-circle.img-fluid(src='assets/img/about/1.jpg', alt='...')
                        .timeline-panel
                            .timeline-heading
                                h4 Founded
                                h4.subheading SM Digital Studio Begins
                            .timeline-body
                                p.text-muted
                                    | SM Digital Studio was created with a simple vision: to deliver high-quality digital solutions through creativity, AI-powered design, professional editing, and modern branding for businesses and creators.
                    li.timeline-inverted
                        .timeline-image
                            img.rounded-circle.img-fluid(src='assets/img/about/2.jpg', alt='...')
                        .timeline-panel
                            .timeline-heading
                                h4 Growth
                                h4.subheading Expanding Our Services
                            .timeline-body
                                p.text-muted
                                    | As our experience grew, SM Digital Studio expanded its services to include AI image editing, graphic design, video editing, branding, social media content, and modern website solutions.
                    li
                        .timeline-image
                            img.rounded-circle.img-fluid(src='assets/img/about/3.jpg', alt='...')
                        .timeline-panel
                            .timeline-heading
                                h4 Innovation
                                h4.subheading AI-Powered Creative Solutions
                            .timeline-body
                                p.text-muted
                                    | We embraced AI-powered creativity to deliver premium image editing, marketing designs, branding, product advertisements, and modern visual content that helps businesses stand out.
                    li.timeline-inverted
                        .timeline-image
                            img.rounded-circle.img-fluid(src='assets/img/about/4.jpg', alt='...')
                        .timeline-panel
                            .timeline-heading
                                h4 Today
                                h4.subheading Your Digital Growth Partner
                            .timeline-body
                                p.text-muted
                                    | Today, SM Digital Studio continues to help businesses, brands, and creators with AI-powered design, professional editing, branding, websites, and digital solutions focused on quality, creativity, and results.
                    li.timeline-inverted
                        .timeline-image
                            h4
                                | Be Part
                                br
                                | Of Our
                                br
                                | Story!

        // Team
        section#team.page-section.bg-light
            .container
                .text-center
                    h2.section-heading.text-uppercase Why Choose SM Digital Studio
                    h3.section-subheading.text-muted Have a project in mind? We'd love to hear from you. Contact SM Digital Studio today. — helping businesses, brands, and creators grow through creative design, AI solutions, and digital innovation.
                .row
                    .col-lg-4
                        .team-member
                            img.mx-auto.rounded-circle(src='assets/img/team/1.jpg', alt='...')
                            h4 Premium Quality
                            p.text-muted High-quality creative work with attention to every detail.
                            

                    .col-lg-4
                        .team-member
                            img.mx-auto.rounded-circle(src='assets/img/team/2.jpg', alt='...')
                            h4 Creative Innovation
                            p.text-muted Modern ideas, AI-powered workflows, and designs that help brands stand out.
                            

                    .col-lg-4
                        .team-member
                            img.mx-auto.rounded-circle(src='assets/img/team/3.jpg', alt='...')
                            h4 Client Satisfaction
                            p.text-muted Dedicated to delivering reliable, professional, and results-driven digital solutions.
      

        // Contact
        section#contact.page-section
            .container
                .text-center
                    h2.section-heading.text-uppercase Get In Touch
                    h3.section-subheading.text-muted Have a project in mind? We'd love to hear from you. Contact SM Digital Studio today.

                // * * * * * * * * * * * * * * *
                // * * SB Forms Contact Form * *
                // * * * * * * * * * * * * * * *

                // This form is pre-integrated with SB Forms.
                // To make this form functional, sign up at
                // https://startbootstrap.com/solution/contact-forms
                // to get an API token!

                 form#contactForm(name='contact' method='POST' data-netlify='true' netlify-honeypot='bot-field')
    input(type='hidden' name='form-name' value='contact')
    input(type='hidden' name='bot-field')

    .row.align-items-stretch.mb-5
        .col-md-6

            .form-group
                input#name.form-control(
                    type='text'
                    name='name'
                    placeholder='Full Name'
                    required
                )

            .form-group
                input#email.form-control(
                    type='email'
                    name='email'
                    placeholder='Business Email'
                    required
                )

            .form-group.mb-md-0
                input#phone.form-control(
                    type='tel'
                    name='phone'
                    placeholder='WhatsApp Number'
                    required
                )

        .col-md-6

            .form-group.form-group-textarea.mb-md-0
                textarea#message.form-control(
                    name='message'
                    placeholder='Tell us about your project...'
                    required
                )

    .text-center.mt-4
        button#submitButton.btn.btn-primary.btn-xl.text-uppercase(type='submit')
            | SEND INQUIRY

        // Footer
        footer.footer.py-4
            .container
                .row.align-items-center
                    .col-lg-4.text-lg-start
                        | © 2026 SM Digital Studio. All Rights Reserved.
                    .col-lg-4.my-3.my-lg-0
                        a.btn.btn-dark.btn-social.mx-2(href='https://x.com', target='_blank', aria-label='X')
                            i.fab.fa-twitter
                        a.btn.btn-dark.btn-social.mx-2(href='https://facebook.com', target='_blank', aria-label='Facebook')
                            i.fab.fa-facebook-f
                        a.btn.btn-dark.btn-social.mx-2(href='https://linkedin.com', target='_blank', aria-label='LinkedIn')
                            i.fab.fa-linkedin-in
                    .col-lg-4.text-lg-end
                        a.link-dark.text-decoration-none.me-3(href='#contact') Contact
                        a.link-dark.text-decoration-none(href='https://github.com/saqibmughal-maker/SM-Digital-Studio', target='_blank') GitHub

        // Portfolio Modals
        include includes/portfolio-modal-1
        include includes/portfolio-modal-2
        include includes/portfolio-modal-3
        include includes/portfolio-modal-4
        include includes/portfolio-modal-5
        include includes/portfolio-modal-6

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='js/scripts.js')

        // * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
