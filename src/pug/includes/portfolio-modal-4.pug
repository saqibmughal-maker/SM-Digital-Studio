// Portfolio item 4 modal popup
#portfolioModal4.portfolio-modal.modal.fade(tabindex='-1', role='dialog', aria-hidden='true')
    .modal-dialog
        .modal-content
            .close-modal(data-bs-dismiss='modal')
                img(src='assets/img/close-icon.svg', alt='Close modal')
            .container
                .row.justify-content-center
                    .col-lg-8
                        .modal-body
                            // Project details
                            h2.text-uppercase AI Poster Design
                            p.item-intro.text-muted Creative Posters for Marketing & Advertising
                            img.img-fluid.d-block.mx-auto(src='assets/img/portfolio/4.jpg', alt='...')
                            p We create eye-catching AI-powered posters for businesses, events, product promotions, restaurants, gaming, social media, and advertising campaigns. Every design combines creativity, modern layouts, and professional visual impact to attract more customers.
                            ul.list-inline
                                li
                                    strong Client:
                                    | Demo Project
                                li
                                    strong Category:
                                    | AI Poster Design
                            button.btn.btn-primary.btn-xl.text-uppercase(data-bs-dismiss='modal', type='button')
                                i.fas.fa-xmark.me-1
                                | Close