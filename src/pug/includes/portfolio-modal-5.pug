// Portfolio item 5 modal popup
#portfolioModal5.portfolio-modal.modal.fade(tabindex='-1', role='dialog', aria-hidden='true')
    .modal-dialog
        .modal-content
            .close-modal(data-bs-dismiss='modal')
                img(src='assets/img/close-icon.svg', alt='Close modal')
            .container
                .row.justify-content-center
                    .col-lg-8
                        .modal-body
                            // Project details
                            h2.text-uppercase Responsive Website
                            p.item-intro.text-muted Modern, Fast & Mobile-Friendly Website Development
                            img.img-fluid.d-block.mx-auto(src='assets/img/portfolio/5.jpg', alt='...')
                            p We develop responsive, modern, and high-performance websites that work perfectly on desktop, tablet, and mobile devices. Every website is optimized for speed, user experience, SEO, and professional business presentation.
                            ul.list-inline
                                li
                                    strong Client:
                                    | Demo Project
                                li
                                    strong Category:
                                    | Responsive Website
                            button.btn.btn-primary.btn-xl.text-uppercase(data-bs-dismiss='modal', type='button')
                                i.fas.fa-xmark.me-1
                                | Close